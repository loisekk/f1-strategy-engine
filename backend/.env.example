# F1 Strategy Engine — ML backend configuration
# Copy to backend/.env and adjust. All keys use the ML_ prefix.

ML_HOST=0.0.0.0
ML_PORT=8000

# Comma-separated frontend origins allowed by CORS
ML_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# Model store location (default: backend/model_store)
# ML_STORE_DIR=./model_store

# Warm model cache (session-persistent loading)
ML_MAX_LOADED_MODELS=8        # LRU cap — active sessions never lose their model
ML_IDLE_TTL_SECONDS=3600      # unload only after 1h of zero use (never after a prediction)
ML_SWEEP_INTERVAL_SECONDS=60  # background sweeper cadence

# Sessions
ML_SESSION_IDLE_TTL_SECONDS=86400

# Security — set a shared secret to protect register/promote/archive/delete/reload.
# Predictions, sessions and health stay open for the UI.
# ML_API_KEY=change-me

# Upload hardening
ML_MAX_UPLOAD_MB=256
ML_ALLOWED_MODEL_EXTENSIONS=.json,.txt,.pkl,.joblib,.ubj
ML_ALLOWED_SCALER_EXTENSIONS=.pkl,.joblib,.json
